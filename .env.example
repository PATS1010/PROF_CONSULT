# PostgreSQL connection string for Supabase or another Postgres database.
DATABASE_URL=

# SMTP server hostname.
SMTP_HOST=

# SMTP server port.
SMTP_PORT=

# SMTP account username.
SMTP_USERNAME=

# SMTP account password or app password.
SMTP_PASSWORD=

# SMTP encryption mode, usually tls.
SMTP_ENCRYPTION=

# Email address shown as the sender.
SMTP_FROM_EMAIL=

# Sender display name.
SMTP_FROM_NAME=
