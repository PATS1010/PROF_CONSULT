# PostgreSQL connection string for Supabase or another Postgres database.
DATABASE_URL=

# Recommended on hosts that block outbound SMTP ports. Use a verified Brevo sender.
# Set BREVO_API_KEY and SMTP_FROM_EMAIL to send verification email over HTTPS.
BREVO_API_KEY=

# SMTP server hostname.
SMTP_HOST=

# SMTP server port.
SMTP_PORT=

# SMTP fallback when BREVO_API_KEY is empty: configure all SMTP values below.
# SMTP account username.
SMTP_USERNAME=

# SMTP account password or app password.
SMTP_PASSWORD=

# SMTP encryption mode, usually tls.
SMTP_ENCRYPTION=

# Email address shown as the sender.
SMTP_FROM_EMAIL=

# Sender display name.
SMTP_FROM_NAME=
