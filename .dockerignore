# Do not copy Git history into the Docker build context.
.git

# Do not copy local environment secrets into the image.
.env

# Ignore all environment files by default.
.env.*

# Keep the safe example environment file.
!.env.example

# Skip Node dependencies if they exist locally.
node_modules

# Skip local Composer dependencies because the Dockerfile installs them fresh.
vendor

# Skip uploaded files so user content is not baked into the image.
uploads

# Skip log files.
*.log

# Skip Vercel's local project metadata.
.vercel

# Skip macOS Finder metadata.
.DS_Store

# Skip Windows thumbnail metadata.
Thumbs.db
